<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <CodePage>65001</CodePage>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MechKitHarness</AssemblyName>
    <RootNamespace>MechKit.Harness</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <SwDir Condition="'$(SwDir)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS</SwDir>
    <MechKitDir Condition="'$(MechKitDir)' == ''">$(MSBuildThisFileDirectory)..\..\src\MechKit\bin\Release</MechKitDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SwDir)\SolidWorks.Interop.sldworks.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SwDir)\SolidWorks.Interop.swconst.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SwDir)\SolidWorks.Interop.swpublished.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="MechKit">
      <HintPath>$(MechKitDir)\MechKit.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
