<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <CodePage>65001</CodePage>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MechKit</AssemblyName>
    <RootNamespace>MechKit</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
    <!-- SOLIDWORKS 安装目录：由 build.ps1 自动探测后通过 /p:SwDir= 传入 -->
    <SwDir Condition="'$(SwDir)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS</SwDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SwDir)\SolidWorks.Interop.sldworks.dll</HintPath>
      <!-- Copy local: 让插件目录自带互操作程序集，避免依赖 SOLIDWORKS 的探测路径 -->
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SwDir)\SolidWorks.Interop.swconst.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SwDir)\SolidWorks.Interop.swpublished.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\icons\*.png" />
  </ItemGroup>

</Project>
